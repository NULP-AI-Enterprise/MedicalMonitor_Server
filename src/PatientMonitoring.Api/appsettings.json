{
  "AllowedOrigins": [ "http://localhost:5225", "https://localhost:7115" ],
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=patientmonitoring;Username=pm_user;Password=pm_password;Pooling=true;CommandTimeout=30;"
  },
  "VitalThresholds": {
    "HeartRate": {
      "CriticalLow": 40,
      "WarningLow": 50,
      "WarningHigh": 110,
      "CriticalHigh": 130
    },
    "SystolicBloodPressure": {
      "CriticalLow": 80,
      "WarningLow": 90,
      "WarningHigh": 140,
      "CriticalHigh": 180
    },
    "DiastolicBloodPressure": {
      "CriticalLow": 40,
      "WarningLow": 60,
      "WarningHigh": 90,
      "CriticalHigh": 120
    },
    "OxygenSaturation": {
      "CriticalLow": 88,
      "WarningLow": 92
    },
    "Temperature": {
      "CriticalLow": 35.0,
      "WarningLow": 36.0,
      "WarningHigh": 38.0,
      "CriticalHigh": 39.5
    },
    "RespiratoryRate": {
      "CriticalLow": 8,
      "WarningLow": 12,
      "WarningHigh": 20,
      "CriticalHigh": 30
    }
  },
  "Jwt": {
    "SecretKey": "PatientMonitoring_VerySecretSecurityKey_AtLeast32BytesLong!_2026",
    "Issuer": "PatientMonitoring",
    "Audience": "PatientMonitoringClients",
    "ExpirationMinutes": 120
  },
  "AlertChannels": {
    "Webhook": {
      "Enabled": false,
      "Url": "",
      "TimeoutSeconds": 5
    },
    "Telegram": {
      "Enabled": false,
      "BotToken": "",
      "ChatId": "",
      "TimeoutSeconds": 5
    }
  },
  "DataRelay": {
    "Enabled": false,
    "TargetUrl": "http://localhost:5050/api/vitals/receive",
    "ApiKey": "secret-relay-token-2026",
    "HeaderName": "X-API-KEY",
    "TimeoutSeconds": 5
  }
}
