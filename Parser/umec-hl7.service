[Unit]
Description=Mindray uMec10 HL7 ORU collector (decode.py --live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hacaton1
WorkingDirectory=/home/hacaton1/proj
ExecStart=/usr/bin/python3 /home/hacaton1/proj/decode.py --live 192.168.0.100
Restart=always
RestartSec=3
# ANSI dashboard output is harmless in the journal; data goes to files.

[Install]
WantedBy=multi-user.target
