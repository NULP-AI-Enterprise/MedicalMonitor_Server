<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UmecAdt</RootNamespace>
    <AssemblyName>adt</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- shared with the ORU decoder: Latin-1 byte carrier, cp1251 de-shift, MLLP constants -->
    <Compile Include="../UmecDecode/Hl7.cs" Link="Hl7.cs" />
  </ItemGroup>

</Project>
