{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/server-{0:yyyy-MM-dd}.log",
      "Append": true,
      "MinLevel": "Information",
      "FileSizeLimitBytes": 52428800,
      "MaxRollingFiles": 10
    }
  },
  "WatchDog": {
    "IpBase": "192.168.2.",
    "StartIp": 100,
    "EndIp": 110,
    "Port": 4601,
    "ConnectTimeoutMs": 500,
    "ScanIntervalMs": 1000
  },
  "NihonKohden": {
    "Monitors": [
      { "Name": "BSM-3562", "Ip": "10.10.46.48", "Protocol": "LsNet", "Port": 7998 }
    ],
    "LsNet": {
      "LocalIp": "10.200.200.77",
      "BedName": "STATION",
      "Waveforms": [ "0101", "0700" ],
      "EcgCountsPerMillivolt": 400
    },
    "ReconnectDelayMs": 10000,
    "ReadTimeoutSeconds": 180
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5230",
  "Security": {
    "IngestionKey": "",
    "OperatorKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Health": {
    "StaleAfterSeconds": 30
  },
  "Swagger": {
    "Enabled": false
  }
}
