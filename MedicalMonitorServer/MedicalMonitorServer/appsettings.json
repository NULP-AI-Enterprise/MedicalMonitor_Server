{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/server-{0:yyyy-MM-dd}.log",
      "Append": true,
      "MinLevel": "Information",
      "FileSizeLimitBytes": 52428800,
      "MaxRollingFiles": 10
    }
  },
  "WatchDog": {
    "IpBase": "192.168.2.",
    "StartIp": 100,
    "EndIp": 110,
    "Port": 4601,
    "ConnectTimeoutMs": 500,
    "ScanIntervalMs": 1000
  },
  "Umec": {
    "ReconnectDelay": "00:00:02",
    "EchoInterval": "00:00:05",
    "QueryRefreshInterval": "00:00:10",
    "ReadTimeout": "00:00:10",
    "ConnectTimeout": "00:00:05",
    "MaxFailedSessions": 5
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5230",
  "Security": {
    "IngestionKey": "",
    "OperatorKey": "",
    "TrustLocalStations": true
  },
  "StationUi": {
    "Path": "../../../MedicalMonitor_Desktop/src/Monitoring.WebService/wwwroot"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Health": {
    "StaleAfterSeconds": 30
  },
  "Swagger": {
    "Enabled": false
  }
}
